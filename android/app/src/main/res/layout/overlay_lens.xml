<?xml version="1.0" encoding="utf-8"?>
<!-- The draggable screen-lens window: a magnifying-glass cursor the user
     drags over a word (its lens center — the exact center of the icon —
     is the precise scan point; see ic_overlay_lens.xml). No close control
     here anymore (it covered the
     cursor and looked broken) — stop the feature via the ongoing
     notification's "Kapat" action instead. Window is WRAP_CONTENT-sized so
     touches outside the cursor itself fall through to whatever app is
     underneath. Padding is bigger than the icon needs on its own, giving a
     generous grab margin around the visible mark since it's a small target
     to land a finger on precisely. Sized larger than the drawable's own
     intrinsic 50dp so it's easier to see exactly which word it's sitting
     on — FIT_CENTER scales it up uniformly, so the lens-center hotspot
     fraction in OcrOverlayService.showLens stays correct either way. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <ImageView
        android:id="@+id/lens_handle"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:elevation="8dp"
        android:src="@drawable/ic_overlay_lens"
        android:contentDescription="@string/widget_lens" />
</FrameLayout>
