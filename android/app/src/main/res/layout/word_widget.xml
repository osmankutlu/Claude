<?xml version="1.0" encoding="utf-8"?>
<!-- A single word/topic card with a faux stacked-deck background (like
     Hanping): exactly one word on screen. Tapping the card shows the next
     random word; the ⚙ (top-left) opens settings, the ★ (top-right)
     favorites the word, and the ⓘ (bottom-right) opens the meaning/examples
     popup. The title auto-sizes so it never clips. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_deck_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/widget_title"
                android:textSize="44sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="76sp"
                android:autoSizeStepGranularity="2sp" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/widget_subtitle"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>

    <!-- Invisible tap zones over the card: left half = previous word,
         right half = next word. Drawn above the card but below the corner
         icons, so ★ / ⚙ / ⓘ taps still win where they are. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widget_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_previous" />

        <FrameLayout
            android:id="@+id/widget_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_next" />
    </LinearLayout>

    <!-- Settings (⚙) top-left -->
    <ImageView
        android:id="@+id/widget_settings"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|start"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:padding="6dp"
        android:src="@drawable/ic_widget_settings"
        android:contentDescription="@string/widget_settings" />

    <!-- Favorite (★) top-right -->
    <ImageView
        android:id="@+id/widget_fav"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginRight="16dp"
        android:layout_marginTop="2dp"
        android:padding="6dp"
        android:src="@drawable/ic_widget_star"
        android:contentDescription="@string/widget_favorite" />

    <!-- Info / meaning (ⓘ) bottom-right -->
    <ImageView
        android:id="@+id/widget_info"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="14dp"
        android:padding="6dp"
        android:src="@drawable/ic_widget_info"
        android:contentDescription="@string/widget_info" />

    <!-- Screen lens (🔍) bottom-left: toggles the draggable OCR overlay
         that reads words in other apps. -->
    <ImageView
        android:id="@+id/widget_lens"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|start"
        android:layout_marginLeft="2dp"
        android:layout_marginBottom="14dp"
        android:padding="6dp"
        android:src="@drawable/ic_widget_lens"
        android:contentDescription="@string/widget_lens" />
</FrameLayout>
