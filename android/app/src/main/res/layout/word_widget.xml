<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background">

    <!-- StackView is the one RemoteViews-supported collection that responds
         to a real user swipe gesture (next/previous card), which is what
         lets swiping the widget change the word/topic without any custom
         gesture handling. Each card is built by WordStackRemoteViewsFactory
         and carries its own tap target (opens the popup for that word). -->
    <StackView
        android:id="@+id/widget_stack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:loopViews="true" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/widget_loading"
        android:textColor="@color/widget_meaning"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
