<?xml version="1.0" encoding="utf-8"?>
<!-- A swipeable deck of word/grammar cards (StackView), like Hanping's
     stacked cards: swipe up/down on the widget to flip to the next/previous
     card — no arrow buttons. The ⚙ (settings) icon in the top-left corner
     opens the widget's settings; each card carries its own ★ favorite icon
     (see word_widget_item.xml). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <StackView
        android:id="@+id/widget_stack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:loopViews="true"
        android:gravity="center" />

    <!-- Shown while the deck is loading / empty. -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="@color/widget_subtitle"
        android:textSize="16sp"
        android:text="@string/widget_loading" />

    <!-- Settings (⚙) — opens the widget configure screen. -->
    <ImageView
        android:id="@+id/widget_settings"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|start"
        android:layout_margin="2dp"
        android:padding="7dp"
        android:src="@drawable/ic_widget_settings"
        android:contentDescription="@string/widget_settings" />
</FrameLayout>
