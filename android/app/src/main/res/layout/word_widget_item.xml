<?xml version="1.0" encoding="utf-8"?>
<!-- One card in the swipeable StackView deck. The whole card opens the
     meaning/examples popup; the ★ in the top-right corner favorites this
     specific word/topic. The title auto-sizes so it never clips. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_bg">

        <LinearLayout
            android:id="@+id/widget_item_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/widget_item_title"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/widget_title"
                android:textSize="40sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="72sp"
                android:autoSizeStepGranularity="2sp" />

            <TextView
                android:id="@+id/widget_item_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/widget_subtitle"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_item_fav"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:padding="7dp"
            android:src="@drawable/ic_widget_star"
            android:contentDescription="@string/widget_favorite" />
    </FrameLayout>
</FrameLayout>
