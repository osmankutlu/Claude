<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is 0 (disabled): onUpdate always picks a fresh
     random word/topic, so a periodic timer would silently swap out
     whatever the user is currently reading. The word only changes on
     screen unlock, via the prev/next arrows, or when the widget is
     placed/reconfigured. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="48dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/word_widget"
    android:configure="com.osmankutlu.zh_en_dict.WidgetConfigureActivity"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
