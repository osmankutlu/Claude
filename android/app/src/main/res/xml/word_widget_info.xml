<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is 0 (disabled): onUpdate calls
     notifyAppWidgetViewDataChanged, which reshuffles the card stack and
     (since items have no stable ids) resets it to position 0 — fine for the
     refreshes we actually want (initial placement, screen unlock, saving new
     widget settings), but not something that should also happen silently
     every 30 minutes while someone might be mid-browse. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="90dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="80dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/word_widget"
    android:configure="com.osmankutlu.zh_en_dict.WidgetConfigureActivity"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
